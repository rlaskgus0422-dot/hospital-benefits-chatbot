!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Supabase로 이관 완료 — 더 이상 앱이 참조하지 않는 옛 로컬 저장소(trash-can/data 참고)
/data

# typescript
*.tsbuildinfo
next-env.d.ts

# AI 에이전트 로컬 도구 설정 (앱 실행에 필요 없음)
/.claude
/.agents
/.bkit
/trash-can
skills-lock.json

.vercel
.env*

# supabase CLI 로컬 캐시(연결 정보 캐시 등, 커밋 불필요)
/supabase/.temp
