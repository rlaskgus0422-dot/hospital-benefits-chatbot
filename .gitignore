# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 로컬 임시 저장소 (Supabase 연동 전까지 사용)
# 콘텐츠성 데이터(카테고리·질문·FAQ 답변)는 배포 시드용으로 예외적으로 커밋하되,
# 운영 로그(대화 로그·문의 메시지)와 업로드 파일은 개인정보 우려로 계속 제외한다.
/data/*
!/data/categories.json
!/data/order.json
!/data/questions.json
!/data/faq-answers.json
!/data/documents.json
/data/uploads
/data/chat-logs.json
/data/contact-messages.json

# typescript
*.tsbuildinfo
next-env.d.ts

# AI 에이전트 로컬 도구 설정 (앱 실행에 필요 없음)
/.claude
/.agents
/.bkit
/trash-can
skills-lock.json
